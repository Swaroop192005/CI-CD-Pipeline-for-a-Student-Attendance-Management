<%- | Integer $app_port,
      String  $app_context_path,
      String  $app_data_dir,
      String  $app_environment,
      Integer $eligibility_threshold,
      Boolean $seed_data,
      String  $java_opts,
      String  $app_version,
| -%>
# Managed by Puppet - changes here are overwritten on the next run.
#
# Every setting the application reads, in one place. The WAR is identical
# across environments; this file is what makes an environment what it is
# (SRS NFR-08).

SERVER_PORT=<%= $app_port %>
SERVER_SERVLET_CONTEXT_PATH=<%= $app_context_path %>

SPRING_DATASOURCE_URL=jdbc:h2:file:<%= $app_data_dir %>/attendance;DB_CLOSE_ON_EXIT=FALSE

ATTENDANCE_ENVIRONMENT=<%= $app_environment %>
ATTENDANCE_ELIGIBILITY_THRESHOLD=<%= $eligibility_threshold %>
ATTENDANCE_SEED_DATA=<%= $seed_data %>

JAVA_OPTS=<%= $java_opts %>

# Recorded so that `cat` on this file answers which release is live.
APP_VERSION=<%= $app_version %>
