# Managed by Ansible - changes here are overwritten on the next run.

upstream attendance_backend {
    server 127.0.0.1:{{ app_port }};
    keepalive 16;
}

server {
    listen {{ nginx_port }};
    server_name {{ nginx_server_name }};

    access_log /var/log/nginx/attendance-access.log;
    error_log  /var/log/nginx/attendance-error.log;

    # The WAR is 60 MB but nothing is uploaded; a small body limit costs
    # nothing and removes a trivial denial-of-service.
    client_max_body_size 2m;

    # Headers the application needs to build correct absolute URLs and to
    # log the real client address rather than 127.0.0.1.
    proxy_set_header Host              $host;
    proxy_set_header X-Real-IP         $remote_addr;
    proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_http_version 1.1;
    proxy_set_header Connection "";

    location / {
        return 302 {{ app_context_path }}/;
    }

    location {{ app_context_path }}/ {
        proxy_pass http://attendance_backend;
        proxy_connect_timeout 5s;
        proxy_read_timeout 60s;
    }

    # Kept separate so a probe never waits behind a slow page request.
    location = {{ health_path }} {
        proxy_pass http://attendance_backend;
        access_log off;
        proxy_read_timeout 5s;
    }
}
