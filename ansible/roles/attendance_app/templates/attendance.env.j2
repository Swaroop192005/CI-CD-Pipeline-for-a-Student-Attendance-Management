# Managed by Ansible - changes here are overwritten on the next run.
#
# Every setting the application reads, in one place. The image and the WAR
# are identical across environments; this file is what makes an environment
# what it is (SRS NFR-08).

SERVER_PORT={{ app_port }}
SERVER_SERVLET_CONTEXT_PATH={{ app_context_path }}

SPRING_DATASOURCE_URL=jdbc:h2:file:{{ app_data_dir }}/attendance;DB_CLOSE_ON_EXIT=FALSE

ATTENDANCE_ENVIRONMENT={{ app_environment }}
ATTENDANCE_ELIGIBILITY_THRESHOLD={{ app_eligibility_threshold }}
ATTENDANCE_SEED_DATA={{ app_seed_data | lower }}

JAVA_OPTS={{ app_java_opts }}

# Recorded so that `cat` on this file answers which release is live.
APP_VERSION={{ app_version }}
