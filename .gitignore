# ---- Build output -------------------------------------------------------
target/
build/
out/
*.war
*.jar
*.ear
!.mvn/wrapper/maven-wrapper.jar

# ---- Application runtime data ------------------------------------------
# H2 file-mode datastore; never commit attendance data (constraint C9).
data/
*.db
*.mv.db
*.trace.db
*.lock.db

# ---- Test and report output -------------------------------------------
# Reports are regenerated by the build. Curated evidence is committed
# under proofs/ instead.
**/surefire-reports/
**/failsafe-reports/
**/jacoco-reports/
**/site/
**/screenshots/
*.hprof

# ---- Logs --------------------------------------------------------------
*.log
logs/
dockerd.log

# ---- IDE and editor ----------------------------------------------------
.idea/
*.iml
*.ipr
*.iws
.vscode/
.settings/
.classpath
.project
.factorypath
nbproject/
*.swp
*~

# ---- OS ----------------------------------------------------------------
.DS_Store
Thumbs.db
desktop.ini

# ---- Secrets and local overrides ---------------------------------------
# Committing credentials would defeat the whole audit story.
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.jks
secrets.yml
ansible/vault-password*
application-local.yml
application-local.properties

# ---- Captured evidence -------------------------------------------------
# proofs/ holds curated, committed evidence for each stage (build logs,
# pipeline output, screenshots, reports). The rules above would otherwise
# exclude it, so it is re-included explicitly.
!proofs/**

# ---- Tooling scratch ---------------------------------------------------
.scannerwork/
.jenkins-local/
chromedriver
geckodriver
node_modules/

# ---- Ansible local state -----------------------------------------------
# The target-node SSH key is generated per environment by
# ansible/targetnode/build-node.sh and must never be committed.
ansible/targetnode/id_node
ansible/targetnode/id_node.pub
ansible/targetnode/authorized_keys
ansible/targetnode/certs/*.crt
ansible/*.retry
